<Window x:Class="provaPing.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:provaPing"
        mc:Ignorable="d"
        Title="Super Ping" Height="450" Width="500" Background="Aquamarine">
    <Grid Margin="20" x:Name="gridPing">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"></ColumnDefinition>
            <ColumnDefinition Width="3*"></ColumnDefinition>
            <ColumnDefinition Width="3*"></ColumnDefinition>
            <ColumnDefinition Width="1*"></ColumnDefinition>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="1.5*"></RowDefinition>
            <RowDefinition Height="1.5*"></RowDefinition>
            <RowDefinition Height="1*"></RowDefinition>
            <RowDefinition Height="1*"></RowDefinition>
            <RowDefinition Height="1*"></RowDefinition>
            <RowDefinition Height="1*"></RowDefinition>
            <RowDefinition Height="1*"></RowDefinition>
            <RowDefinition Height="1*"></RowDefinition>
            <RowDefinition Height="1*"></RowDefinition>
            <RowDefinition Height="1*"></RowDefinition>
            <RowDefinition Height="1*"></RowDefinition>
            <RowDefinition Height="1*"></RowDefinition>
            <RowDefinition Height="1*"></RowDefinition>
        </Grid.RowDefinitions>
        <TextBlock x:Name="txtStatus"/>
        <TextBlock x:Name="txtMs"/>
        <Button Background="Green" Grid.Row="0" Grid.Column="1" Grid.RowSpan="2" FontSize="30" x:Name="btnStart" Click="btnStart_Click">Start</Button>
        <Button Grid.Column="2" Background="Red" Grid.Row="0" Grid.RowSpan="2" FontSize="30" x:Name="btnStop" Click="btnStop_Click">Stop</Button>
        <ProgressBar x:Name="barProgresso" Grid.RowSpan="2" Grid.Column="0" Minimum="0" Maximum="30" Value="0" />
        <Button Grid.Column="3" Grid.Row="0"  x:Name="btnAdd" Click="btnAdd_Click">+</Button>
        <Button Grid.Column="3" Grid.Row="1" x:Name="btnDel" Click="btnDel_Click">-</Button>
    </Grid>
</Window>
